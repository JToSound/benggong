# ================================================
# 《病港》互動地圖 — 環境變數範例
# 複製為 .env 並自行填寫。切勿將 .env commit 入 repo。
# ================================================

# ---- OpenRouter（Phase B extraction 用；key 切勿外洩）----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ORCHESTRATOR_MODEL=
OPENROUTER_CODING_MODEL=
OPENROUTER_EXTRACTION_MODEL=
OPENROUTER_VISION_MODEL=

# ---- 內容同步（預設停用；未授權不可開啟）----
SYNC_ENABLED=false

# ---- ComfyUI（本機 only，禁止 cloud endpoint）----
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ROOT=
COMFYUI_AUTO_START=true
COMFYUI_PORT=8188
COMFYUI_ALLOW_MODEL_DOWNLOAD=false

# ---- 前端 build ----
VITE_BASE_PATH=/
VITE_PROVISIONAL_DATA_MODE=true
