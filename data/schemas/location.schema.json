{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/location.schema.json",
  "title": "《病港》公開位置資料",
  "description": "GeoJSON Feature。真實香港名稱只可作參考位置；虛構地點不可配真實坐標。",
  "type": "object",
  "required": [
    "type",
    "geometry",
    "properties"
  ],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "geometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "id",
        "name",
        "display_name",
        "location_type",
        "fictional",
        "location_precision",
        "story_position",
        "description",
        "first_appearance",
        "chapters",
        "characters",
        "confidence",
        "review_status",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "display_name": {
          "type": "string",
          "maxLength": 60
        },
        "location_type": {
          "enum": [
            "district",
            "street",
            "building",
            "facility",
            "landmark",
            "fictional",
            "overseas",
            "unknown"
          ]
        },
        "fictional": {
          "type": "boolean"
        },
        "location_precision": {
          "enum": [
            "exact",
            "approximate",
            "district",
            "fictional",
            "unknown"
          ]
        },
        "story_position": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "description": {
          "type": "string",
          "maxLength": 100
        },
        "first_appearance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 198
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 198
          }
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": {
          "enum": [
            "needs_review",
            "reviewed",
            "verified"
          ]
        },
        "source": {
          "enum": [
            "bing_gang",
            "bing_gang_2"
          ]
        },
        "inferred_from": {
          "description": "若座標由 scripts/infer_places.py 推斷得出，記錄推斷 id",
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "description": "同一地點嘅其他寫法（合併之後保留，可追溯）",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "zone_ids": {
          "description": "所屬區域 id（由 scripts/derive_zones.py 反向填入；同 zones.geojson 嘅 member_location_ids 必須一致）",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "map_hidden": {
          "description": "由地圖標記排除（例如「旺角」係比喻、「香港」係整體設定）。資料仍然保留。",
          "type": "boolean"
        },
        "position_source": {
          "description": "座標嘅來源說明（人手修正／同章錨定等），可稽核。",
          "type": "string"
        }
      }
    }
  }
}
