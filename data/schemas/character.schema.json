{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/character.schema.json",
  "title": "《病港》公開角色資料",
  "type": "object",
  "required": [
    "id", "name", "aliases", "role", "color", "first_appearance",
    "chapter_refs", "spoiler_level", "description",
    "confidence", "review_status", "portrait_asset_id", "source"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string", "maxLength": 40 },
    "aliases": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
    "role": {
      "enum": ["protagonist", "main", "supporting", "antagonist", "minor"]
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "first_appearance": { "type": "integer", "minimum": 1, "maximum": 198 },
    "chapter_refs": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 198 }, "minItems": 1 },
    "spoiler_level": { "type": "integer", "minimum": 0, "maximum": 3 },
    "description": { "type": "string", "maxLength": 150 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_status": { "enum": ["needs_review", "reviewed", "verified"] },
    "portrait_asset_id": {
      "description": "對應 public/assets/markers 或 generated 內嘅資產 id；未有圖用 null。",
      "type": ["string", "null"]
    },
    "source": { "enum": ["bing_gang", "bing_gang_2"] }
  }
}
